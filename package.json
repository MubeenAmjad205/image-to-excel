{
  "name": "image-to-excel-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute image-to-excel --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute image-to-excel --local --file=schema.sql",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "node --experimental-strip-types test/format.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
